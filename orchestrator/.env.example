# 编排服务配置

# 服务端口
ORCHESTRATOR_PORT=8000

# ========== 抖音爬虫 API 配置 ==========
# Douyin_TikTok_Download_API 服务地址
DOUYIN_API_BASE_URL=http://localhost:5000

# ========== Dify 配置 ==========
# Dify API 地址
DIFY_API_BASE_URL=http://localhost:8080
# Dify API Key（在 Dify 后台创建应用后获取）
DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx
# Dify 知识库 ID（在 Dify 后台创建知识库后获取）
DIFY_DATASET_ID=

# ========== 语音识别配置 ==========
# 使用的引擎: faster-whisper / funasr
ASR_ENGINE=faster-whisper
# Whisper 模型大小: tiny / base / small / medium / large-v3
WHISPER_MODEL_SIZE=base
# 语言: zh / en / auto
WHISPER_LANGUAGE=zh
# 设备: cpu / cuda
WHISPER_DEVICE=cpu
# 计算类型: int8 / float16 / float32
WHISPER_COMPUTE_TYPE=int8

# ========== 视频处理配置 ==========
# 视频保存路径
VIDEO_STORAGE_PATH=./data/videos
# 音频保存路径
AUDIO_STORAGE_PATH=./data/audios
# 转录文本保存路径
TRANSCRIPT_STORAGE_PATH=./data/transcripts

# ========== 数据库配置 ==========
DATABASE_URL=sqlite+aiosqlite:///./data/orchestrator.db

# ========== Gemini / LLM（仅服务端，切勿提交真实密钥）==========
GEMINI_API_BASE_URL=https://grsai.dakka.com.cn
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# ========== 抖音 Cookie（获取博主全部视频必需）==========
# 未登录时抖音 API 硬限制只返回约 40-44 条最近作品。
# 请从已登录的 douyin.com 浏览器开发者工具复制完整 Cookie：
# DOUYIN_COOKIE=ttwid=...; sessionid=...; sid_tt=...; ...
DOUYIN_COOKIE=

# ========== 任务配置 ==========
# 并发下载数
MAX_CONCURRENT_DOWNLOADS=3
# 并发转文字数
MAX_CONCURRENT_TRANSCRIBE=2
# 视频处理总并发上限（下载+ASR+AI解析）
MAX_CONCURRENT_VIDEOS=1000
# 请求间隔（秒）
REQUEST_INTERVAL=2
# 最大爬取视频数（0表示不限制）
MAX_VIDEOS_PER_BLOGGER=0
